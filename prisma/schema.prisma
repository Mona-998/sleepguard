generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  fullName     String
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())

  orders Order[]
}

model Order {
  id              String   @id @default(cuid())
  fullName        String
  email           String
  phone           String
  emirate         String
  address         String
  paymentIntentId String
  amountAed       Int
  status          String   @default("paid")
  createdAt       DateTime @default(now())

  // Optional — orders can still be placed without an account (guest checkout).
  // When the user is signed in at checkout, this gets set so their orders
  // show up on their account.
  user   User?   @relation(fields: [userId], references: [id])
  userId String?
}
